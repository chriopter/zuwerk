<header class="workspace-topbar">
  <div class="workspace-topbar-inner">
    <div class="topbar-zone topbar-zone-start">
      <%= link_to root_path(account_number: nil), class: "tb-pill tb-pill-round topbar-home #{'is-active' if active == :projects && project.blank?}", aria: { label: "Home" } do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h5v-6h4v6h5V9.5"/></svg>
      <% end %>
      <details class="project-switcher">
        <summary class="tb-pill" aria-label="Switch project">
          <span class="project-switcher-name"><%= project.present? ? project.name : "Zuwerk" %></span>
          <span class="project-switcher-chevron" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span>
        </summary>
        <div class="project-switcher-menu">
          <div class="project-switcher-list">
            <% workspace_projects.each do |option| %>
              <%= link_to project_path(option), class: "project-switcher-option #{'is-active' if option == project}" do %>
                <span><%= option.name %></span>
                <% if option == project %><i aria-hidden="true">✓</i><% end %>
              <% end %>
            <% end %>
          </div>
        </div>
      </details>
    </div>

    <div class="topbar-zone topbar-zone-center">
      <% if project.present? %>
        <% active_tool = active == :projects ? :chat : (active == :briefing ? :inbox : active) %>
        <nav class="topbar-project-tools" aria-label="Project tools" data-controller="tool-shortcuts" data-action="keydown@window->tool-shortcuts#navigate">
          <%= link_to inbox_path(project_id: project.id), class: "#{'is-active' if active_tool == :inbox}", aria: { label: "Inbox, shortcut 1", current: ("page" if active_tool == :inbox), keyshortcuts: "1" }, data: { shortcut: "1" } do %>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16l2 12H16l-2 3h-4l-2-3H2Z"/></svg><span class="topbar-project-tool-label" aria-hidden="true">Inbox</span>
          <% end %>
          <%= link_to project_chat_path(project), class: "#{'is-active' if active_tool == :chat}", aria: { label: "Chat, shortcut 2", current: ("page" if active_tool == :chat), keyshortcuts: "2" }, data: { shortcut: "2" } do %>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z"/></svg><span class="topbar-project-tool-label" aria-hidden="true">Chat</span>
          <% end %>
          <%= link_to project_tasks_path(project), class: "#{'is-active' if active_tool == :tasks}", aria: { label: "Tasks, shortcut 3", current: ("page" if active_tool == :tasks), keyshortcuts: "3" }, data: { shortcut: "3" } do %>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="m8 12 2.5 2.5L16 9"/></svg><span class="topbar-project-tool-label" aria-hidden="true">Tasks</span>
          <% end %>
          <%= link_to project_file_entries_path(project), class: "#{'is-active' if active_tool == :files}", aria: { label: "Files, shortcut 4", current: ("page" if active_tool == :files), keyshortcuts: "4" }, data: { shortcut: "4" } do %>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/></svg><span class="topbar-project-tool-label" aria-hidden="true">Files</span>
          <% end %>
        </nav>
      <% end %>
    </div>

    <div class="topbar-zone topbar-zone-end">
      <% online = online_agents %>
      <details class="topbar-status-menu">
        <summary class="tb-pill-hit" aria-label="Agents and account, <%= pluralize(online.size, 'agent') %> online" title="<%= pluralize(online.size, 'agent') %> online">
          <span class="tb-pill tb-pill-round topbar-agents <%= 'is-active' if active == :agents %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 20v-2a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v2M16 4.5a3 3 0 0 1 0 5.8M17 13a5 5 0 0 1 4 4.9V20"/></svg>
            <span class="topbar-agents-dot <%= 'is-online' if online.any? %>" aria-hidden="true"></span>
          </span>
        </summary>
        <div>
          <% if Current.account %><%= link_to "Agents", agents_path, aria: (active == :agents ? { current: "page" } : {}) %><% end %>
          <% online.each do |agent| %>
            <span class="topbar-status-agent"><span class="topbar-agents-dot is-online" aria-hidden="true"></span><span><%= agent.name %></span></span>
          <% end %>
          <% if current_user.admin? %><%= link_to "Database", database_path, aria: (active == :database ? { current: "page" } : {}) %><% end %>
          <%= button_to "Log out", session_path, method: :delete %>
        </div>
      </details>
    </div>
  </div>
</header>
