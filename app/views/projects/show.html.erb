<% content_for :title, "#{@project.name} · Zuwerk" %>

<%= turbo_stream_from @chat.home_stream %>
<%= turbo_stream_from @project.agent_turn_stream %>
<%= turbo_stream_from Current.account.agent_presence_stream %>

<section class="project-home" aria-labelledby="project-title">
  <header class="sr-only">
    <h1 id="project-title"><%= @project.name %></h1>
  </header>

  <section class="project-live-chat" aria-labelledby="project-chat-title" data-controller="chat-scroll">
    <h2 id="project-chat-title" class="sr-only">Chat</h2>

    <div id="project_live_messages" class="project-live-messages" data-controller="own-messages"
      data-own-messages-user-value="<%= current_user.id %>" data-chat-scroll-target="viewport" data-action="scroll->chat-scroll#track">
      <div class="project-live-empty"><strong>Start the conversation</strong><span>Write a message or mention an agent to begin working together.</span></div>
      <%= render partial: "projects/live_message", collection: @recent_chat_messages, as: :chat_message, locals: { current_user: current_user } %>
    </div>

    <div class="project-live-status">
      <%= render "chat_messages/agent_presence", agents: @agents %>
      <%= render "agent_events/chat_status", project: @project %>
    </div>

    <%= render "projects/chat_entry", project: @project, message: @message, agents: @agents %>
  </section>
</section>
