<% viewer = local_assigns[:current_user] %>
<% preview = strip_tags(render_message_markdown(chat_message.body)).squish %>
<article id="<%= chat_message.live_dom_id %>" data-author-id="<%= chat_message.author_id %>"
  class="project-live-message <%= 'is-own' if viewer && viewer.id == chat_message.author_id %> <%= 'is-agent' if chat_message.author.agent? %>">
  <i aria-hidden="true"><%= chat_message.author.name.first.upcase %></i>
  <div>
    <header>
      <strong><%= chat_message.author.name %></strong>
      <time datetime="<%= chat_message.created_at.iso8601 %>" data-controller="relative-time"><%= time_ago_in_words(chat_message.created_at) %> ago</time>
    </header>
    <p><%= preview.presence || pluralize(chat_message.attachments.size, "attachment") %></p>
  </div>
</article>
